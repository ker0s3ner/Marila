file type latex:
[
p1 - "A Mathematical Note" :: "Generated by Marila"
section1 - "Foundations"
subsection1 - "Definitions"
quote1 - "A concise mathematical document can contain computation and exposition." :: "Marila"
link1 - "Marila" :: "https://example.com/marila"
definition1 - "A vector is an element of a vector space."
theorem1 - "Pythagorean Theorem" :: "For a right triangle, a^2 + b^2 = c^2."
p2 - "The area is <integral |0||1|| x^2 dx>."
point A at (0, 0) label "Origin"
point B at (3, 0) label "Base"
line from A to B
plot2d sin(x) over x in [-3.14, 3.14]
plot3d sin(x) * cos(y) over x, y in [-2, 2] & title "Surface" & color "green"
plot3d data [[0, 1, 0], [1, 2, 1], [0, 1, 0]] & title "Measured" & color "purple"
plot2d vectorfield (-y, x) over x, y in [-2, 2] & color "cyan"
]

render latex
